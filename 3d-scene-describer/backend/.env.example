# Environment Variables – 3D Scene Describer Backend

# ===== ANTHROPIC (Claude) =====
# Get from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-your-claude-key-here

# ===== GOOGLE GEMINI =====
# Get from: https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=YOUR_GOOGLE_API_KEY

# ===== SERVER =====
# Port (optional, default: 3001)
PORT=3001

# ===== NOTES =====
# - NEVER commit this .env file to Git
# - Copy this file to .env and fill in your actual keys
# - If ANTHROPIC_API_KEY is set: uses Claude
# - If ANTHROPIC_API_KEY fails: falls back to GOOGLE_GEMINI_API_KEY
# - Both are optional - app will use mock data if both missing
